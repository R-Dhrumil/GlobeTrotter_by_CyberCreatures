// Prisma Schema for GlobeTrotter PostgreSQL (Railway Ready)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BudgetCategory {
  TRANSPORT
  STAY
  ACTIVITIES
  MEALS
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(USER)
  photoUrl     String?       @default("")
  languagePref String        @default("en")
  status       UserStatus    @default(ACTIVE)
  department   String?       @default("Traveler")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  trips        Trip[]
  transactions Transaction[]

  @@index([email])
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model City {
  id              String     @id @default(uuid())
  name            String
  country         String
  region          String     @default("Global")
  costIndex       Int        @default(3) // 1 to 5
  popularityScore Int        @default(80) // 1 to 100
  imageUrl        String
  description     String     @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  activities      Activity[]
  stops           Stop[]

  @@index([name])
  @@index([country])
  @@index([region])
}

model Activity {
  id              String         @id @default(uuid())
  cityId          String
  city            City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name            String
  category        String         @default("Sightseeing") // Sightseeing, Adventure, Food & Drink, Nature, Culture, Nightlife
  cost            Float          @default(0.0)
  durationMinutes Int            @default(120)
  description     String         @db.Text
  imageUrl        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  stopActivities  StopActivity[]

  @@index([cityId])
  @@index([category])
}

model Trip {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  startDate     DateTime?
  endDate       DateTime?
  description   String?       @db.Text
  coverPhotoUrl String?       @default("")
  isPublic      Boolean       @default(false)
  shareSlug     String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stops         Stop[]
  budgets       Budget[]
  transactions  Transaction[]

  @@index([userId])
  @@index([shareSlug])
}

model Stop {
  id            String         @id @default(uuid())
  tripId        String
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId        String
  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  orderIndex    Int            @default(0)
  arrivalDate   DateTime?
  departureDate DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  activities    StopActivity[]

  @@index([tripId])
  @@index([cityId])
}

model StopActivity {
  id            String    @id @default(uuid())
  stopId        String
  stop          Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activityId    String
  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  scheduledDate DateTime?
  scheduledTime String?   // "09:00 AM"
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([stopId])
  @@index([activityId])
}

model Budget {
  id              String         @id @default(uuid())
  tripId          String
  trip            Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category        BudgetCategory @default(OTHER)
  estimatedAmount Float          @default(0.0)
  actualAmount    Float          @default(0.0)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tripId])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  group     String   @default("GENERAL") // SMTP, PAYMENT, SEO, GENERAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

model Transaction {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  amount     Float
  currency   String            @default("USD")
  gateway    String            @default("STRIPE") // STRIPE, RAZORPAY, PAYPAL
  status     TransactionStatus @default(COMPLETED)
  gatewayRef String?           @default("")
  notes      String?           @default("")
  createdAt  DateTime          @default(now())

  @@index([userId])
  @@index([tripId])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?  @default("General Inquiry")
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}
